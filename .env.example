# Copy to .env.local (local dev) or set these in Vercel / Netlify project settings.
# NEVER commit real keys. These are read by the server functions only and are not bundled into the app.

# Server-side key for Places API (New). Restrict it to the Places API and set quotas + billing alerts.
GOOGLE_MAPS_API_KEY=

# Optional: comma-separated origins allowed to call /api/places (e.g. https://your-app.vercel.app)
ALLOWED_ORIGINS=
